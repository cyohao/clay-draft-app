{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clay Draft",
  "version": "1.0.0",
  "identifier": "com.claydraft.editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clay Draft",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 380,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#FAF9F5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Clay Draft",
    "copyright": "Clay Draft",
    "category": "Productivity",
    "shortDescription": "Markdown 编辑器",
    "longDescription": "面向中文技术文档写作的 Markdown 编辑器：实时预览、层级目录、中文字数统计、编码与换行符原样保留。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "ClayDraft.md",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
